{
  "name": "studio-experiment-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A bounded agent workbench for planning, approving and evaluating Flagsmith experiments.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "agent": "node scripts/mcp.mjs",
    "traffic": "node --env-file-if-exists=.env scripts/traffic.mjs"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
